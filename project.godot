; Engine configuration file.
config_version=5

[application]

config/name="Slime: Rise of Tempest"
config/description="RPG 2D inspirado em Tensei shitara Slime Datta Ken"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Data="*res://scripts/autoload/data.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
Flow="*res://scripts/autoload/flow.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/override_width=1280
window/size/override_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

